# Copy this file to .streamlit/secrets.toml for local runs (it is git-ignored).
# On Streamlit Community Cloud, paste these into: App settings -> Secrets.

ANTHROPIC_API_KEY = "sk-ant-..."        # Claude Console -> API keys (set a monthly spend limit!)
COURTLISTENER_TOKEN = "..."             # courtlistener.com -> Profile -> Developer Tools -> API token

# Optional
CLAUDE_MODEL = "claude-sonnet-5-5"
RUNS_PER_SESSION = "3"                  # new AI-checked memos per visitor
RUNS_PER_DAY = "150"                    # across all visitors
